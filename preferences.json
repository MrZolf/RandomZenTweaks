[
  {
    "property": "mod.randomzentweaks.essentials-audio.enabled",
    "label": "Moduł Essentials: przycisk wyciszania i wizualizator / Essentials module: mute button and visualizer",
    "type": "checkbox",
    "defaultValue": false
  },
  {
    "property": "mod.randomzentweaks.essentials-audio.mute-position",
    "label": "Pozycja ikony wyciszenia / Mute icon position",
    "type": "dropdown",
    "defaultValue": "top-right",
    "options": [
      { "label": "Prawy górny róg / Top right", "value": "top-right" },
      { "label": "Lewy górny róg / Top left", "value": "top-left" },
      { "label": "Prawy dolny róg / Bottom right", "value": "bottom-right" },
      { "label": "Lewy dolny róg / Bottom left", "value": "bottom-left" }
    ],
    "conditions": [
      { "if": { "property": "mod.randomzentweaks.essentials-audio.enabled", "value": true } }
    ]
  },
  {
    "property": "mod.randomzentweaks.essentials-audio.mute-style",
    "label": "Styl ikony wyciszenia / Mute icon style",
    "type": "dropdown",
    "defaultValue": "light",
    "options": [
      { "label": "Jasna / Light", "value": "light" },
      { "label": "Ciemna / Dark", "value": "dark" }
    ],
    "conditions": [
      { "if": { "property": "mod.randomzentweaks.essentials-audio.enabled", "value": true } }
    ]
  },
  {
    "property": "mod.randomzentweaks.essentials-audio.visualizer-color",
    "label": "Kolor wizualizatora / Visualizer color",
    "type": "dropdown",
    "defaultValue": "mono",
    "options": [
      { "label": "Monochromatyczny / Monochrome", "value": "mono" },
      { "label": "Kolor Zen / Zen accent color", "value": "accent" }
    ],
    "conditions": [
      { "if": { "property": "mod.randomzentweaks.essentials-audio.enabled", "value": true } }
    ]
  },
  {
    "property": "mod.randomzentweaks.essentials-audio.visualizer-width",
    "label": "Szerokość wizualizatora / Visualizer width",
    "type": "dropdown",
    "defaultValue": "small",
    "options": [
      { "label": "Mała / Small", "value": "small" },
      { "label": "Średnia / Medium", "value": "medium" },
      { "label": "Duża (cały kafelek) / Large (full tile)", "value": "large" }
    ],
    "conditions": [
      { "if": { "property": "mod.randomzentweaks.essentials-audio.enabled", "value": true } }
    ]
  }
]
