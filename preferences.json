[
  {
    "property": "mod.randomzentweaks.essentials-audio.enabled",
    "label": "Essentials mute button and visualiser",
    "type": "checkbox",
    "defaultValue": false
  },
  {
    "property": "mod.randomzentweaks.essentials-audio.mute-position",
    "label": "Mute icon position",
    "type": "dropdown",
    "placeholder": "Top right",
    "defaultValue": "top-right",
    "options": [
      {
        "label": "Top right",
        "value": "top-right"
      },
      {
        "label": "Top left",
        "value": "top-left"
      },
      {
        "label": "Bottom right",
        "value": "bottom-right"
      },
      {
        "label": "Bottom left",
        "value": "bottom-left"
      },
      {
        "label": "Middle (slightly above the favicon)",
        "value": "middle"
      }
    ],
    "conditions": [
      {
        "if": {
          "property": "mod.randomzentweaks.essentials-audio.enabled",
          "value": true
        }
      }
    ]
  },
  {
    "property": "mod.randomzentweaks.essentials-audio.mute-style",
